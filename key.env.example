# API Keys Configuration
# Copy this file to 'key.env' and add your actual API keys

# Groq AI API Key (for AI-powered insights)
# Get your key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Google OAuth Client ID (optional - for Google login)
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here

# JWT Secret Key (required - use a strong random string)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_secret_jwt_key_here

# Optional: Gemini API Key (if using Google's Gemini AI)
GEMINI_API_KEY=your_gemini_api_key_here
